# Secret-free template only. Configure secrets privately on the hosting account.
APP_NAME=PROBABLUE
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://probablue.freedev.app
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=sql311.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_43081983_probablue
DB_USERNAME=if0_43081983
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Database-backed SMTP settings must also be disabled for this demo.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_USERNAME=
MAIL_PASSWORD=
WHATSAPP_STAGE_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

VITE_APP_NAME="${APP_NAME}"

# Fail closed until the owner privately supplies demo access credentials.
# This protects Laravel pages, not directly served public assets or uploads.
DEMO_ACCESS_ENABLED=true
DEMO_ACCESS_USERNAME=
DEMO_ACCESS_PASSWORD=
